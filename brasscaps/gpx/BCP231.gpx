      <groundspeak:short_description html="True">&lt;BR&gt;&lt;a href='http://brasscap.albertabattlecache.ca/capbreakdown/BCP231.html'TARGET='resource window'&gt;Past Finds for BCP231&lt;/a&gt;&lt;BR&gt;&lt;a href='https://www.geocaching.com/seek/log.aspx?ID=17395&amp;LogType=2'TARGET='resource window'&gt;Log Your Find&lt;/a&gt;</groundspeak:short_description>
