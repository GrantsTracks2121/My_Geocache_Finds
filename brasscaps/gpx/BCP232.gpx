          <groundspeak:text encoded="True">&lt;p&gt;BCP232 - Lunnford&lt;/p&gt;
&lt;p&gt;Quick park, walk, fence jump and find. TFTBC!!!!&lt;/p&gt;

          </groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="193474769">
          <groundspeak:log_wpt lat="54.064517" lon="-114.300683" />
          <groundspeak:date>2011-10-17T20:00:00</groundspeak:date>
