        <groundspeak:log id="342597242">
          <groundspeak:date>2013-08-18T20:00:00</groundspeak:date>
          <groundspeak:type>Found it</groundspeak:type>
          <groundspeak:finder id="4853503">gumbyphv</groundspeak:finder>
          <groundspeak:text encoded="True">&lt;p&gt;I found BCP526 Decoigne while camping at the beautiful Tete Jaune Lodge.  We decided to head into Jasper to check out Maligne Canyon and on the way back to Tete Jaune Lodge I made a quick stop here to grab this brass cap.  Awesome views from here.  Thanks for another great brass cap.  TFTBC  &lt;img src="/images/icons/icon_smile_big.gif" border="0" align="middle" /&gt;&lt;/p&gt;

          </groundspeak:text>
        </groundspeak:log>
