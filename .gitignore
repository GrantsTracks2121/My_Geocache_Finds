# macOS clutter
.DS_Store

# Personal Claude Code settings for this Mac
.claude/settings.local.json

# Python cache
__pycache__/

# Personal data — kept on the Mac, never committed
# (the My Finds pocket query and the days.js file built from it)
*.gpx
data/

# Your own trips, favourites, places, settings and Dashboard pictures.
# serve.py starts each one empty when it is missing, so a new user starts fresh.
trips.json
favorites.json
places.json
settings.json
profile/

# Exceptions: the public brass cap GPX files, and test samples
!brasscaps/gpx/*.gpx
!samples/*.gpx

# Your own brass cap finds (made from your Cacher Stats page in Settings).
# The cap GPX files in brasscaps/gpx/ are public and shared by everyone.
brasscaps/brasscaps.json
brasscaps/stats.html

# GeoNames download and lookup file (large; rebuilt by build_places.py)
geonames/

# Statistics Canada boundary download (large). The lookup file made from it,
# boundaries/csd.tsv.gz, is small enough to ship with the app.
boundaries/*
!boundaries/csd.tsv.gz

# Temporary files while loading a dropped My Finds file (serve.py)
.upload.tmp
*.gpx.bak
